# Postgres (usar DATABASE_URL o las variables sueltas)
DATABASE_URL=postgres://user:password@localhost:5432/consultas
DB_SSL=false
# Gmail (app password)
GMAIL=
GMAIL_PASS=
# Mercado Pago
MP_ACCESS_TOKEN=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=http://localhost:3000/payments
SUBSCRIPTION_PRICE=1000
